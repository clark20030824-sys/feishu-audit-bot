# ===== 飞书自建应用凭证 =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件签名校验用的 app_secret 即上面的 secret。
# 若你在飞书事件订阅里额外设置了“验证令牌(verification token)”，填这里；没有就留空。
FEISHU_VERIFICATION_TOKEN=

# 监听的端口（本地调试常用 3000）
PORT=3000

# 公网回调路径（需与飞书事件订阅里填的 URL 一致）
# 例如 ngrok 给的地址：https://xxxx.ngrok-free.app/feishu/event
# 这里只填路径部分，且要和 index.js 里 app.post 的路径一致
CALLBACK_PATH=/feishu/event

# ===== 大模型（OpenAI 兼容接口）=====
# 默认走 OpenAI；换成你的 UPP/antpkg/其他兼容服务只需改 base 与 key
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# 审核报告默认 @ 的负责人 open_id（飞书成员 open_id，ou_xxx）。
# 不填则默认 @ 触发消息的发送人。
AUDITOR_OPEN_ID=
